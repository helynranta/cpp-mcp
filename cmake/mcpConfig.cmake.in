@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Boost::system is a PUBLIC dependency of mcp
find_dependency(Boost REQUIRED COMPONENTS system)
find_dependency(Threads REQUIRED)
find_dependency(nlohmann_json CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/mcpTargets.cmake")

check_required_components(mcp)
