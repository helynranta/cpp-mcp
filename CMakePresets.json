{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset with common settings",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Base preset for Windows with MSVC compiler",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "description": "Debug build with tests enabled for development",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Development Release",
      "description": "Release build with tests enabled for development",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "ci",
      "displayName": "CI Build",
      "description": "Release build with tests for CI",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/vcpkg-cache,readwrite"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build without tests",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ssl",
      "displayName": "Release with SSL",
      "description": "Release build with SSL support enabled",
      "inherits": "release",
      "cacheVariables": {
        "MCP_SSL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "description": "Build using dev-debug configuration",
      "configuration": "Debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "description": "Build using dev-release configuration",
      "configuration": "Release"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "description": "Build using CI configuration",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Build optimized release",
      "configuration": "Release"
    },
    {
      "name": "ssl",
      "configurePreset": "ssl",
      "description": "Build release with SSL",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "description": "Run tests for dev-debug configuration",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 0
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "description": "Run tests for dev-release configuration",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 0
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "description": "Run tests for CI",
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      },
      "execution": {
        "jobs": 0
      }
    }
  ]
}
