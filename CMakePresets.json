{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 10,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base preset with common settings",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "description": "Debug build with tests enabled for development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Development Release",
      "description": "Release build with tests enabled for development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux",
      "description": "Release build with tests for Linux CI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/vcpkg-cache,readwrite"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows",
      "description": "Release build with tests for Windows CI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/vcpkg-cache,readwrite"
      }
    },
    {
      "name": "sanitizer-address",
      "displayName": "Sanitizer - Address",
      "description": "Debug build with AddressSanitizer and tests",
      "inherits": "dev-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "sanitizer-undefined",
      "displayName": "Sanitizer - Undefined Behavior",
      "description": "Debug build with UndefinedBehaviorSanitizer and tests",
      "inherits": "dev-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "coverage",
      "displayName": "Code Coverage",
      "description": "Debug build with code coverage instrumentation",
      "inherits": "dev-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_C_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build without tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MCP_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ssl",
      "displayName": "Release with SSL",
      "description": "Release build with SSL support enabled",
      "inherits": "release",
      "cacheVariables": {
        "MCP_SSL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "description": "Build using dev-debug configuration",
      "configuration": "Debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "description": "Build using dev-release configuration",
      "configuration": "Release"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "description": "Build using CI Linux configuration",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "description": "Build using CI Windows configuration",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "sanitizer-address",
      "configurePreset": "sanitizer-address",
      "description": "Build with AddressSanitizer",
      "configuration": "Debug"
    },
    {
      "name": "sanitizer-undefined",
      "configurePreset": "sanitizer-undefined",
      "description": "Build with UndefinedBehaviorSanitizer",
      "configuration": "Debug"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "description": "Build with code coverage",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Build optimized release",
      "configuration": "Release"
    },
    {
      "name": "ssl",
      "configurePreset": "ssl",
      "description": "Build release with SSL",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "description": "Run tests for dev-debug configuration",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "description": "Run tests for dev-release configuration",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "description": "Run tests for CI Linux",
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      },
      "filter": {
        "include": {
          "name": "mcp_tests"
        }
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "configuration": "Release",
      "description": "Run tests for CI Windows",
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose"
      },
      "filter": {
        "include": {
          "name": "mcp_tests"
        }
      }
    },
    {
      "name": "sanitizer-address",
      "configurePreset": "sanitizer-address",
      "description": "Run tests with AddressSanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizer-undefined",
      "configurePreset": "sanitizer-undefined",
      "description": "Run tests with UndefinedBehaviorSanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "description": "Run tests for coverage analysis",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
